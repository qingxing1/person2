# 部署环境变量模板
# 复制为 .env 后填入真实值。.env 不入库, 由服务器本地维护,
# CI 的 rsync 已排除 .env, 不会被覆盖或删除。
COMPOSE_PROJECT_NAME=nest-admin-app

# 镜像名前缀 (对应 docker-compose.yml 中的 image)
ACR_REGISTRY=person

# MySQL
MYSQL_ROOT_PASSWORD=change-me-before-deploy
MYSQL_DATABASE=kapok
# 以下端口一律只绑定 127.0.0.1, 供宿主机本地调试用;
# 外网流量统一由 gateway 容器按域名分发, 数据库/缓存不直接对外。
MYSQL_PORT=3306

# Redis (当前未启用密码, 因此绝不能暴露到公网)
REDIS_PORT=6379

# 后端 API
BACKEND_PORT=6999

TZ=Asia/Shanghai
