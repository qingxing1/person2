{
  "name": "person-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for person project",
  "private": true,
  "scripts": {
    "install:all": "pnpm -r --filter=./packages/* install",
    "install:backend": "pnpm --dir packages/backend install",
    "install:admin": "pnpm --dir packages/admin-frontend install",
    "install:personal": "pnpm --dir packages/personal-site install",
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "concurrently \"pnpm:dev:*\"",
    "dev:all": "concurrently \"pnpm:dev:*\"",
    "dev:backend": "pnpm --dir packages/backend run start:dev",
    "dev:admin": "pnpm --dir packages/admin-frontend run dev",
    "dev:personal": "pnpm --dir packages/personal-site run dev",
    "start:backend": "pnpm --dir packages/backend run start",
    "start:admin": "pnpm --dir packages/admin-frontend run preview",
    "start:personal": "pnpm --dir packages/personal-site run preview",
    "test": "pnpm -r --filter=./packages/* run test",
    "lint": "pnpm -r --filter=./packages/* run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}